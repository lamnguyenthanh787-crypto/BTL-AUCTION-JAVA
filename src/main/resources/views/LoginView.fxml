<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.LoginController">
    <children>
        <Label text="ĐĂNG NHẬP HỆ THỐNG ĐẤU GIÁ">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
            <VBox.margin>
                <Insets bottom="20.0" />
            </VBox.margin>
        </Label>
        <VBox maxWidth="300.0" spacing="5.0">
            <children>
                <Label text="Tên đăng nhập:" />
                <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập..." />
            </children>
        </VBox>
        <VBox maxWidth="300.0" spacing="5.0">
            <children>
                <Label text="Mật khẩu:" />
                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu..." />
            </children>
        </VBox>
        <Label fx:id="errorLabel" textFill="RED" />
        <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="300.0" text="Đăng nhập" textFill="WHITE" style="-fx-background-color: #007bff; -fx-font-weight: bold; -fx-cursor: hand;" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>